# Copy to .env and fill in. See README → "One-time setup".

# Firebase console → Project settings (kortex-a24b7) → Your apps → Web app config. Not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (type: Chrome extension).
OAUTH_CLIENT_ID=

# Public key that pins the extension id across unpacked reloads (manifest "key"). One line, no PEM header.
EXTENSION_KEY=
