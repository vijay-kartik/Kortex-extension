# Copy to .env and fill in. See README → "One-time setup".

# Firebase console → Project settings (kortex-a24b7) → Your apps → Web app config. Not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (type: Web application),
# with redirect URI https://<extension id>.chromiumapp.org/ (see README). Not secret.
VITE_GOOGLE_WEB_CLIENT_ID=
201049504537-f748s8gigbhev8usvqah5pj4bhtlsopf.apps.googleusercontent.com

# Public key that pins the extension id across unpacked reloads (manifest "key"). One line, no PEM header.
EXTENSION_KEY=
